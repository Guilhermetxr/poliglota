# Copie para .env.local e preencha com as chaves do seu app web no Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Config).
# Essas chaves não são secretas: quem protege os dados são as regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Chat com tutor (só no SERVIDOR: nunca use o prefixo VITE_ nestas) ---
# Serve qualquer serviço de IA com API "OpenAI-compatível". Padrão: Groq (gratuito).
# Chave em console.groq.com > API Keys. Em produção, cadastre na Vercel.
AI_API_KEY=
# Opcionais (os valores abaixo são os padrões):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
# Outros serviços gratuitos (confira o nome atual do modelo no painel de cada um):
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1   (use um modelo com sufixo ":free")
# Se o serviço reclamar do formato de resposta, desligue o modo JSON:
# AI_JSON_MODE=off
# Mensagens por pessoa por dia (padrão 40):
# CHAT_DAILY_LIMIT=40
