# Copie para .env.local e preencha com as chaves do seu app web no Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Config).
# Essas chaves não são secretas: quem protege os dados são as regras do Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Chat com tutor (só no SERVIDOR: nunca use o prefixo VITE_ nestas) ---
# Chave da API da Anthropic (console.anthropic.com). Em produção, cadastre na Vercel.
ANTHROPIC_API_KEY=
# Opcional: modelo do tutor. Padrão claude-opus-5-5. Para gastar ~40x menos: claude-haiku-5-5
# CHAT_MODEL=claude-haiku-5-5
# Opcional: mensagens por pessoa por dia. Padrão 40.
# CHAT_DAILY_LIMIT=40
